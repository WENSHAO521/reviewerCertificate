msgid "plugins.generic.reviewerCertificate.settings.annualBodyTemplate"
msgstr "Annual and cumulative certificates"

msgid "plugins.generic.reviewerCertificate.settings.annualBodyTemplateDescription"
msgstr "Reviewers can download these from My Certificates. They use the same layout, images and styles as the single certificate, with the text below as the body, and have no certificate code or QR code. Extra variables: {{$reviewCount}} (number of reviews) and {{$reviewYear}}."

msgid "plugins.generic.reviewerCertificate.settings.annualBodyTemplateLabel"
msgstr "Annual certificate text"

msgid "plugins.generic.reviewerCertificate.settings.cumulativeBodyTemplate"
msgstr "Cumulative certificate text"

msgid "plugins.generic.reviewerCertificate.settings.cumulativeBodyTemplateDescription"
msgstr "One certificate with the total number of reviews the reviewer has completed for this journal, like Elsevier's \"Recognized Reviewer\" certificate. {{$reviewPeriod}} is the span of years, e.g. 2021–2026."

msgid "plugins.generic.reviewerCertificate.annual.cumulative"
msgstr "All years ({$total} reviews)"

msgid "plugins.generic.reviewerCertificate.settings.outstandingMinReviews"
msgstr "Outstanding Reviewer: reviews in the last two years (0 = off)"

msgid "plugins.generic.reviewerCertificate.settings.outstandingLabel"
msgstr "Title for outstanding reviewers"

msgid "plugins.generic.reviewerCertificate.settings.recognizedLabel"
msgstr "Title for other reviewers"

msgid "plugins.generic.reviewerCertificate.settings.outstandingDescription"
msgstr "Like Elsevier's Recognized and Outstanding Reviewer status. {{$reviewerStatus}} on the cumulative certificate shows the outstanding title when the reviewer completed at least this many reviews for the journal in the last two years, and the other title otherwise. My Certificates shows the same title."


msgid "plugins.generic.reviewerCertificate.manage.menu"
msgstr "Certificate Management"

msgid "plugins.generic.reviewerCertificate.manage.pageDescription"
msgstr "Statistics, issued certificates, batch issuing, email notifications and settings for this journal's reviewer certificates, all in one place."

msgid "plugins.generic.reviewerCertificate.manage.settingsNotice"
msgstr "Statistics, issued certificates, batch issuing, email notifications and these certificate settings are all on the Certificate Management page, listed below Statistics in the side menu."

msgid "plugins.generic.reviewerCertificate.manage.clearSearch"
msgstr "Clear"

msgid "plugins.generic.reviewerCertificate.manage.tabOverview"
msgstr "Overview"

