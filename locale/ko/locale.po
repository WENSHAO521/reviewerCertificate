msgid "plugins.generic.reviewerCertificate.verify.dateIssued"
msgstr "발급일"

msgid "plugins.generic.reviewerCertificate.verify.revoked"
msgstr "Certificate Revoked"

msgid "plugins.generic.reviewerCertificate.verify.revokedDescription"
msgstr "This certificate was issued by the journal but revoked on {$date}. It is no longer valid."

# Batch generation
msgid "plugins.generic.reviewerCertificate.batch.title"
msgstr "일괄 인증서 생성"

msgid "plugins.generic.reviewerCertificate.batch.description"
msgstr "여러 심사자의 인증서를 한 번에 생성합니다. 아래 목록에서 심사를 완료했지만 아직 인증서가 없는 심사자를 선택하세요."

msgid "plugins.generic.reviewerCertificate.batch.selectReviewers"
msgstr "심사자 선택"

msgid "plugins.generic.reviewerCertificate.batch.completedReviews"
msgstr "완료된 심사"

msgid "plugins.generic.reviewerCertificate.batch.noEligibleReviewers"
msgstr "자격이 있는 심사자가 없습니다. 모든 심사자가 완료된 심사에 대한 인증서를 가지고 있습니다."

msgid "plugins.generic.reviewerCertificate.batch.selectMultipleHint"
msgstr "Ctrl(Windows/Linux) 또는 Cmd(Mac)를 누른 상태에서 클릭하여 여러 명 선택"

msgid "plugins.generic.reviewerCertificate.batch.generate"
msgstr "인증서 생성"

msgid "plugins.generic.reviewerCertificate.batch.generating"
msgstr "인증서 생성 중..."

msgid "plugins.generic.reviewerCertificate.batch.noSelection"
msgstr "심사자를 한 명 이상 선택하세요"

msgid "plugins.generic.reviewerCertificate.batch.certificatesGenerated"
msgstr "인증서가 성공적으로 생성되었습니다"

msgid "plugins.generic.reviewerCertificate.batch.error"
msgstr "인증서 생성 중 오류가 발생했습니다. 다시 시도하세요."

msgid "plugins.generic.reviewerCertificate.batch.generated"
msgstr "{$count}개의 인증서가 성공적으로 생성되었습니다"

msgid "plugins.generic.reviewerCertificate.batch.generatedCountLabel"
msgstr "Generated"

msgid "plugins.generic.reviewerCertificate.batch.skipped"
msgstr "Skipped"

msgid "plugins.generic.reviewerCertificate.batch.failed"
msgstr "Failed"

