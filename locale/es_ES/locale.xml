	<message key="plugins.generic.reviewerCertificate.settings.typography.name">Reviewer Name</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.nameDescription">A line holding only {{$reviewerName}}. Suggested 24–26 pt, bold.</message>
