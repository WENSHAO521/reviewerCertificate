	<message key="plugins.generic.reviewerCertificate.settings.typography.titleDescription">The line starting with # (or the header text). Suggested 28–46 pt.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.name">Reviewer Name</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.nameDescription">A line holding only {{$reviewerName}}. Suggested 24–26 pt, bold.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.journal">Journal Name</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.journalDescription">A line holding only {{$journalName}}. Suggested 16–20 pt.</message>
