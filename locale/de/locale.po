msgstr "Zertifikat(e) erfolgreich erstellt"

msgid "plugins.generic.reviewerCertificate.batch.error"
msgstr "Beim Erstellen der Zertifikate ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut."

