msgstr "Πρότυπο Κυρίως Κειμένου Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.bodyTemplateDescription"
msgstr "Το κύριο περιεχόμενο του πιστοποιητικού. Χρησιμοποιήστε μεταβλητές προτύπου για εισαγωγή δυναμικού περιεχομένου."

msgid "plugins.generic.reviewerCertificate.settings.bodyTemplateRequired"
msgstr "Το πρότυπο κυρίως κειμένου πιστοποιητικού είναι υποχρεωτικό"

msgid "plugins.generic.reviewerCertificate.settings.footerText"
msgstr "Κείμενο Υποσέλιδου"

msgid "plugins.generic.reviewerCertificate.settings.footerTextDescription"
msgstr "Προαιρετικό κείμενο που εμφανίζεται στο κάτω μέρος του πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.availableVariables"
msgstr "Διαθέσιμες Μεταβλητές Προτύπου"

msgid "plugins.generic.reviewerCertificate.settings.availableVariablesDescription"
msgstr "Χρησιμοποιήστε αυτές τις μεταβλητές στα πρότυπά σας για εισαγωγή δυναμικού περιεχομένου:"

msgid "plugins.generic.reviewerCertificate.settings.defaultTemplate"
msgstr "Προεπιλεγμένο πρότυπο"

msgid "plugins.generic.reviewerCertificate.settings.useDefaultTemplate"
msgstr "Χρήση προεπιλεγμένου προτύπου"

msgid "plugins.generic.reviewerCertificate.settings.appearance"
msgstr "Ρυθμίσεις Εμφάνισης"

msgid "plugins.generic.reviewerCertificate.settings.fontFamily"
msgstr "Οικογένεια Γραμματοσειράς"

msgid "plugins.generic.reviewerCertificate.settings.font.helvetica"
msgstr "Helvetica"

msgid "plugins.generic.reviewerCertificate.settings.font.times"
msgstr "Times New Roman"

msgid "plugins.generic.reviewerCertificate.settings.font.courier"
msgstr "Courier"

msgid "plugins.generic.reviewerCertificate.settings.font.dejavusans"
msgstr "DejaVu Sans"

msgid "plugins.generic.reviewerCertificate.settings.fontSize"
msgstr "Μέγεθος Γραμματοσειράς"

msgid "plugins.generic.reviewerCertificate.settings.pageOrientation"
msgstr "Προσανατολισμός σελίδας"

msgid "plugins.generic.reviewerCertificate.settings.pageOrientationDescription"
msgstr "Επιλέξτε κατακόρυφη (πορτραίτο) ή οριζόντια (τοπίο) διάταξη για το πιστοποιητικό"

msgid "plugins.generic.reviewerCertificate.settings.orientation.portrait"
msgstr "Κατακόρυφος (πορτραίτο)"

msgid "plugins.generic.reviewerCertificate.settings.orientation.landscape"
msgstr "Οριζόντιος (τοπίο)"

msgid "plugins.generic.reviewerCertificate.settings.textColor"
msgstr "Default text colour"

msgid "plugins.generic.reviewerCertificate.settings.textColorDescription"
msgstr "Καθορίστε το χρώμα κειμένου χρησιμοποιώντας τιμές RGB (0-255 για κάθε συνιστώσα)"

msgid "plugins.generic.reviewerCertificate.settings.eligibility"
msgstr "Κριτήρια Επιλεξιμότητας"

msgid "plugins.generic.reviewerCertificate.settings.minimumReviews"
msgstr "Ελάχιστες Ολοκληρωμένες Κριτικές"

msgid "plugins.generic.reviewerCertificate.settings.minimumReviewsDescription"
msgstr "Ο ελάχιστος αριθμός ολοκληρωμένων κριτικών που απαιτούνται πριν ένας κριτής μπορεί να λάβει πιστοποιητικό"

msgid "plugins.generic.reviewerCertificate.settings.minimumReviewsInvalid"
msgstr "Οι ελάχιστες κριτικές πρέπει να είναι αριθμός μεγαλύτερος ή ίσος με 1"

msgid "plugins.generic.reviewerCertificate.settings.verification"
msgstr "Επιλογές Επαλήθευσης"

msgid "plugins.generic.reviewerCertificate.settings.includeQRCode"
msgstr "Συμπερίληψη κωδικού QR για επαλήθευση πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.previewCertificate"
msgstr "Προεπισκόπηση Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.invalidImageType"
msgstr "Μη έγκυρος τύπος εικόνας. Παρακαλώ ανεβάστε αρχείο JPG ή PNG."

msgid "plugins.generic.reviewerCertificate.settings.uploadFailed"
msgstr "Η μεταφόρτωση αρχείου απέτυχε. Παρακαλώ δοκιμάστε ξανά."

msgid "plugins.generic.reviewerCertificate.settings.fontUnicodeWarning"
msgstr "Σημείωση: Οι γραμματοσειρές Helvetica, Times New Roman και Courier υποστηρίζουν μόνο λατινικούς χαρακτήρες. Εάν το περιοδικό σας χρησιμοποιεί μη λατινικούς χαρακτήρες, το πρόσθετο θα χρησιμοποιήσει αυτόματα τη γραμματοσειρά DejaVu Sans."

msgid "plugins.generic.reviewerCertificate.settings.invalidValue"
msgstr "Enter a valid value."

# Error messages
msgid "plugins.generic.reviewerCertificate.error.reviewNotCompleted"
msgstr "Αυτή η κριτική δεν έχει ολοκληρωθεί ακόμα. Τα πιστοποιητικά είναι διαθέσιμα μόνο για ολοκληρωμένες κριτικές."

msgid "plugins.generic.reviewerCertificate.error.noCertificateCode"
msgstr "Δεν παρέχεται κωδικός πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.error.invalidCertificate"
msgstr "Μη έγκυρος κωδικός πιστοποιητικού. Αυτό το πιστοποιητικό δεν μπόρεσε να επαληθευτεί."

msgid "plugins.generic.reviewerCertificate.error.noReviewersSelected"
msgstr "Δεν επιλέχθηκαν κριτές για μαζική δημιουργία πιστοποιητικών"

msgid "plugins.generic.reviewerCertificate.error.accessDenied"
msgstr "Πρόσβαση απορρίφθηκε. Δεν έχετε άδεια να κατεβάσετε αυτό το πιστοποιητικό."

msgid "plugins.generic.reviewerCertificate.error.noContext"
msgstr "Δεν υπάρχει διαθέσιμο περιβάλλον περιοδικού. Βεβαιωθείτε ότι έχετε πρόσβαση από έγκυρο περιοδικό."

msgid "plugins.generic.reviewerCertificate.error.daoNotAvailable"
msgstr "Η πρόσβαση στη βάση δεδομένων δεν είναι διαθέσιμη αυτή τη στιγμή. Επικοινωνήστε με το διαχειριστή συστήματος."

# Email templates
msgid "plugins.generic.reviewerCertificate.email.subject"
msgstr "Το Πιστοποιητικό σας είναι Έτοιμο!"

msgid "plugins.generic.reviewerCertificate.email.body"
msgstr "{{$reviewerName}},\n\nΣας ευχαριστούμε για την ολοκλήρωση αυτής της κριτικής. Μπορείτε τώρα να κατεβάσετε το πιστοποιητικό αναγνώρισής σας.\n\nΛήψη Πιστοποιητικού: {{$certificateUrl}}\n\n{{$journalName}}\n{{$journalUrl}}"

# Verification
msgid "plugins.generic.reviewerCertificate.verify.title"
msgstr "Επαλήθευση Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.verify.description"
msgstr "Εισάγετε έναν κωδικό πιστοποιητικού για να επαληθεύσετε την αυθεντικότητά του"

msgid "plugins.generic.reviewerCertificate.verify.code"
msgstr "Κωδικός Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.verify.button"
msgstr "Επαλήθευση Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.verify.valid"
msgstr "Έγκυρο Πιστοποιητικό"

msgid "plugins.generic.reviewerCertificate.verify.invalid"
msgstr "Μη Έγκυρο Πιστοποιητικό"

msgid "plugins.generic.reviewerCertificate.verify.invalidDescription"
msgstr "Ο κωδικός πιστοποιητικού που εισάγατε δεν είναι έγκυρος ή δεν υπάρχει στο σύστημά μας."

msgid "plugins.generic.reviewerCertificate.verify.certificateCode"
msgstr "Κωδικός Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.verify.reviewerName"
msgstr "Όνομα Κριτή"

msgid "plugins.generic.reviewerCertificate.verify.journalName"
msgstr "Όνομα Περιοδικού"

msgid "plugins.generic.reviewerCertificate.verify.dateIssued"
msgstr "Ημερομηνία Έκδοσης"

# Batch generation
msgid "plugins.generic.reviewerCertificate.batch.title"
msgstr "Μαζική Δημιουργία Πιστοποιητικών"

msgid "plugins.generic.reviewerCertificate.batch.description"
msgstr "Δημιουργήστε πιστοποιητικά για πολλαπλούς κριτές ταυτόχρονα. Επιλέξτε κριτές από την παρακάτω λίστα που έχουν ολοκληρώσει κριτικές αλλά δεν έχουν ακόμη πιστοποιητικά."

msgid "plugins.generic.reviewerCertificate.batch.selectReviewers"
msgstr "Επιλογή Κριτών"

msgid "plugins.generic.reviewerCertificate.batch.completedReviews"
msgstr "ολοκληρωμένες κριτικές"

msgid "plugins.generic.reviewerCertificate.batch.noEligibleReviewers"
msgstr "Δεν βρέθηκαν επιλέξιμοι κριτές. Όλοι οι κριτές έχουν πιστοποιητικά για τις ολοκληρωμένες κριτικές τους."

msgid "plugins.generic.reviewerCertificate.batch.selectMultipleHint"
msgstr "Κρατήστε πατημένο Ctrl (Windows/Linux) ή Cmd (Mac) για να επιλέξετε πολλαπλούς κριτές"

msgid "plugins.generic.reviewerCertificate.batch.generate"
msgstr "Δημιουργία Πιστοποιητικών"

msgid "plugins.generic.reviewerCertificate.batch.generating"
msgstr "Δημιουργία πιστοποιητικών..."

msgid "plugins.generic.reviewerCertificate.batch.noSelection"
msgstr "Παρακαλώ επιλέξτε τουλάχιστον έναν κριτή"

msgid "plugins.generic.reviewerCertificate.batch.certificatesGenerated"
msgstr "πιστοποιητικό(ά) δημιουργήθηκαν επιτυχώς"

msgid "plugins.generic.reviewerCertificate.batch.error"
msgstr "Προέκυψε σφάλμα κατά τη δημιουργία πιστοποιητικών. Παρακαλώ δοκιμάστε ξανά."

msgid "plugins.generic.reviewerCertificate.batch.generated"
msgstr "{$count} πιστοποιητικό(ά) δημιουργήθηκαν επιτυχώς"

msgid "plugins.generic.reviewerCertificate.batch.generatedCountLabel"
msgstr "Generated"

msgid "plugins.generic.reviewerCertificate.batch.skipped"
msgstr "Skipped"

msgid "plugins.generic.reviewerCertificate.batch.failed"
msgstr "Failed"

# Statistics
msgid "plugins.generic.reviewerCertificate.statistics.title"
msgstr "Στατιστικά Πιστοποιητικών"

msgid "plugins.generic.reviewerCertificate.statistics.description"
msgstr "Επισκόπηση της δημιουργίας και χρήσης πιστοποιητικών στο περιοδικό σας"

msgid "plugins.generic.reviewerCertificate.statistics.totalCertificates"
msgstr "Συνολικά Εκδοθέντα Πιστοποιητικά"

msgid "plugins.generic.reviewerCertificate.statistics.totalDownloads"
msgstr "Συνολικές Λήψεις"

msgid "plugins.generic.reviewerCertificate.statistics.uniqueReviewers"
msgstr "Μοναδικοί Κριτές με Πιστοποιητικά"

msgid "plugins.generic.reviewerCertificate.stats.totalIssued"
msgstr "Συνολικά Εκδοθέντα Πιστοποιητικά"

msgid "plugins.generic.reviewerCertificate.stats.totalDownloads"
msgstr "Συνολικές Λήψεις"

msgid "plugins.generic.reviewerCertificate.stats.averageDownloads"
msgstr "Μέσος Όρος Λήψεων ανά Πιστοποιητικό"

msgid "plugins.generic.reviewerCertificate.settings"
msgstr "Ρυθμίσεις Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.removeBackgroundImage"
msgstr "Remove the background image"

msgid "plugins.generic.reviewerCertificate.settings.logoImage"
msgstr "Logo"

msgid "plugins.generic.reviewerCertificate.settings.logoImageDescription"
msgstr "Placed top left unless you set X and Y. A PNG with a transparent background works best."

msgid "plugins.generic.reviewerCertificate.settings.coverImage"
msgstr "Journal Cover"

msgid "plugins.generic.reviewerCertificate.settings.coverImageDescription"
msgstr "Placed top right unless you set X and Y. Swap it here when a new issue comes out."

msgid "plugins.generic.reviewerCertificate.settings.sealImage"
msgstr "Seal"

msgid "plugins.generic.reviewerCertificate.settings.sealImageDescription"
msgstr "Placed bottom right, or just left of the QR code when that is on. Use a transparent PNG for a round seal."

msgid "plugins.generic.reviewerCertificate.settings.removeImage"
msgstr "Remove this image"

msgid "plugins.generic.reviewerCertificate.settings.image.width"
msgstr "Width (mm)"

msgid "plugins.generic.reviewerCertificate.settings.image.x"
msgstr "X from left (mm, -1 = auto)"

msgid "plugins.generic.reviewerCertificate.settings.image.y"
msgstr "Y from top (mm, -1 = auto)"

msgid "plugins.generic.reviewerCertificate.settings.bodyTopOffset"
msgstr "Body Top Spacing (mm)"

msgid "plugins.generic.reviewerCertificate.settings.bodyTopOffsetDescription"
msgstr "Extra blank space in millimetres above the body text. Use this to move the body down the page; blank lines typed at the start of the body template are removed when the form is saved."

msgid "plugins.generic.reviewerCertificate.settings.typography"
msgstr "Typography (Structured Layout)"

msgid "plugins.generic.reviewerCertificate.settings.layoutMode"
msgstr "Certificate Layout"

msgid "plugins.generic.reviewerCertificate.settings.layoutModeDescription"
msgstr "Classic renders the body template as one block of text, as in earlier versions. Structured gives each line its own style: a line holding only {{$reviewerName}} (or first/last name) uses the reviewer name style, a line holding only {{$journalName}} uses the journal name style, lines with a date or {{$certificateCode}} use the detail style, and all other lines use the body text style. Blank lines in the template add paragraph spacing. Long names and titles shrink to fit one line, then wrap, and the whole layout scales down if needed to stay on one page."

msgid "plugins.generic.reviewerCertificate.settings.layoutMode.classic"
msgstr "Classic (single text block)"

msgid "plugins.generic.reviewerCertificate.settings.layoutMode.structured"
msgstr "Structured (separate title, name, journal and detail styles)"

msgid "plugins.generic.reviewerCertificate.settings.typography.title"
msgstr "Certificate Title"

msgid "plugins.generic.reviewerCertificate.settings.typography.titleDescription"
msgstr "The line starting with # (or the header text). Suggested 28–46 pt."

msgid "plugins.generic.reviewerCertificate.settings.typography.name"
msgstr "Reviewer Name"

msgid "plugins.generic.reviewerCertificate.settings.typography.nameDescription"
msgstr "A line holding only {{$reviewerName}}. Suggested 24–26 pt, bold."

msgid "plugins.generic.reviewerCertificate.settings.typography.journal"
msgstr "Journal Name"

msgid "plugins.generic.reviewerCertificate.settings.typography.journalDescription"
msgstr "A line holding only {{$journalName}}. Suggested 16–20 pt."

msgid "plugins.generic.reviewerCertificate.settings.typography.body"
msgstr "Acknowledgement Text"

msgid "plugins.generic.reviewerCertificate.settings.typography.bodyDescription"
msgstr "All other lines. Suggested 12–16 pt."

msgid "plugins.generic.reviewerCertificate.settings.typography.detail"
msgstr "Review Date and Certificate Code"

msgid "plugins.generic.reviewerCertificate.settings.typography.detailDescription"
msgstr "Lines with a date, and the certificate code. Suggested 8–11 pt."

msgid "plugins.generic.reviewerCertificate.settings.typography.size"
msgstr "Size (pt)"

msgid "plugins.generic.reviewerCertificate.settings.typography.bold"
msgstr "Bold"

msgid "plugins.generic.reviewerCertificate.settings.typography.spacing"
msgstr "Spacing (mm)"

msgid "plugins.generic.reviewerCertificate.settings.typography.spacingDescription"
msgstr "Paragraph spacing is added for each blank line between body lines. Name spacing is extra space above and below the reviewer name. Side margin narrows the text area so text stays clear of logos in the background image."

msgid "plugins.generic.reviewerCertificate.settings.typography.paragraphSpacing"
msgstr "Paragraph spacing"

msgid "plugins.generic.reviewerCertificate.settings.typography.nameSpacing"
msgstr "Name spacing"

msgid "plugins.generic.reviewerCertificate.settings.section.layout"
msgstr "Layout and text"

msgid "plugins.generic.reviewerCertificate.settings.section.layoutDescription"
msgstr "Choose how the certificate is laid out and write what it says."

msgid "plugins.generic.reviewerCertificate.settings.layoutMode.classicHint"
msgstr "One block of text, as in earlier versions. Existing certificates keep this look."

msgid "plugins.generic.reviewerCertificate.settings.layoutMode.structuredHint"
msgstr "Title, reviewer name, journal and details each get their own style, like a printed award."

msgid "plugins.generic.reviewerCertificate.settings.titleLineHint"
msgstr "Start a line with # to make it the certificate title, e.g. \"# Certificate of Reviewing\". A line with only {{$reviewerName}} uses the name style, a line with only {{$journalName}} the journal style, and lines with a date the small detail style."

msgid "plugins.generic.reviewerCertificate.settings.insertVariable"
msgstr "Insert:"

msgid "plugins.generic.reviewerCertificate.settings.useRecognitionTemplate"
msgstr "Use recognition-style template"

msgid "plugins.generic.reviewerCertificate.settings.section.images"
msgstr "Background, logo, cover and seal"

msgid "plugins.generic.reviewerCertificate.settings.section.imagesDescription"
msgstr "PNG or JPEG, up to 5 MB each. The background fills the page; the other images are placed on top. Leave X and Y empty for the automatic position."

msgid "plugins.generic.reviewerCertificate.settings.image.none"
msgstr "Not set"

msgid "plugins.generic.reviewerCertificate.settings.image.xShort"
msgstr "X (mm)"

msgid "plugins.generic.reviewerCertificate.settings.image.yShort"
msgstr "Y (mm)"

msgid "plugins.generic.reviewerCertificate.settings.image.auto"
msgstr "auto"

msgid "plugins.generic.reviewerCertificate.settings.section.typographyDescription"
msgstr "Size, colour and weight for each part of a structured certificate."

msgid "plugins.generic.reviewerCertificate.settings.typography.classicNotice"
msgstr "These controls apply to the structured layout. Choose \"Structured\" in step 1 to use them."

msgid "plugins.generic.reviewerCertificate.settings.typography.element"
msgstr "Element"

msgid "plugins.generic.reviewerCertificate.settings.typography.style"
msgstr "Style"

msgid "plugins.generic.reviewerCertificate.settings.typography.defaultColor"
msgstr "default"

msgid "plugins.generic.reviewerCertificate.settings.section.page"
msgstr "Page and colours"

msgid "plugins.generic.reviewerCertificate.settings.section.pageDescription"
msgstr "Paper orientation, font and the default text colour."

msgid "plugins.generic.reviewerCertificate.settings.previewHint"
msgstr "The preview uses the last saved settings, so save first."

msgid "plugins.generic.reviewerCertificate.settings.typography.color"
msgstr "Colour (#rrggbb)"

msgid "plugins.generic.reviewerCertificate.settings.typography.uppercase"
msgstr "Uppercase"

msgid "plugins.generic.reviewerCertificate.settings.typography.footer"
msgstr "Footer"

msgid "plugins.generic.reviewerCertificate.settings.typography.footerDescription"
msgstr "The footer text; set its position below."

msgid "plugins.generic.reviewerCertificate.settings.typography.footerPosition"
msgstr "Position"

msgid "plugins.generic.reviewerCertificate.settings.typography.footerBottomSpacing"
msgstr "Distance from bottom (mm)"

msgid "plugins.generic.reviewerCertificate.settings.typography.sideMargin"
msgstr "Side margin"

msgid "plugins.generic.reviewerCertificate.settings.footerPosition.flow"
msgstr "Below the content"

msgid "plugins.generic.reviewerCertificate.settings.footerPosition.bottomLeft"
msgstr "Bottom left"

msgid "plugins.generic.reviewerCertificate.settings.footerPosition.bottomCenter"
msgstr "Bottom centre"

msgid "plugins.generic.reviewerCertificate.myCertificates.title"
msgstr "Τα πιστοποιητικά μου"

msgid "plugins.generic.reviewerCertificate.myCertificates.description"
msgstr "Παρακάτω βρίσκεται η λίστα όλων των πιστοποιητικών αξιολόγησής σας για αυτό το περιοδικό."

msgid "plugins.generic.reviewerCertificate.myCertificates.dateIssued"
msgstr "Ημερομηνία έκδοσης"

msgid "plugins.generic.reviewerCertificate.myCertificates.submissionTitle"
msgstr "Τίτλος υποβολής"

msgid "plugins.generic.reviewerCertificate.myCertificates.certificateCode"
msgstr "Κωδικός πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.myCertificates.actions"
msgstr "Ενέργειες"

msgid "plugins.generic.reviewerCertificate.myCertificates.noCertificates"
msgstr "Δεν έχετε ακόμα πιστοποιητικά. Τα πιστοποιητικά δημιουργούνται μετά την ολοκλήρωση μιας αξιολόγησης."

msgid "plugins.generic.reviewerCertificate.myCertificates.viewAll"
msgstr "Προβολή όλων των πιστοποιητικών μου"

msgid "plugins.generic.reviewerCertificate.myCertificates.emailAction"
msgstr "Αποστολή του πιστοποιητικού στο email μου"

msgid "plugins.generic.reviewerCertificate.myCertificates.emailSent"
msgstr "Το πιστοποιητικό στάλθηκε στη διεύθυνση email σας."

msgid "plugins.generic.reviewerCertificate.myCertificates.emailError"
msgstr "Δεν ήταν δυνατή η αποστολή του email. Δοκιμάστε ξανά αργότερα ή επικοινωνήστε με το περιοδικό."

msgid "plugins.generic.reviewerCertificate.settings.ackEmailSubject"
msgstr "Θέμα ευχαριστήριου email"

msgid "plugins.generic.reviewerCertificate.settings.ackEmailBody"
msgstr "Κείμενο ευχαριστήριου email"

msgid "plugins.generic.reviewerCertificate.settings.ackEmailDescription"
msgstr "Επιστολή που αποστέλλεται στον κριτή από τη σελίδα «Τα πιστοποιητικά μου», με συνημμένο το πιστοποιητικό PDF. Υποστηρίζει τις ίδιες μεταβλητές προτύπου με το κείμενο του πιστοποιητικού, καθώς και {{$editorName}}."

msgid "plugins.generic.reviewerCertificate.emailCertificate.attachmentFallback"
msgstr "Δεν ήταν δυνατή η επισύναψη του PDF του πιστοποιητικού σε αυτό το μήνυμα (ενδέχεται να υπερβαίνει το όριο μεγέθους του διακομιστή αλληλογραφίας). Μπορείτε να κατεβάσετε το πιστοποιητικό σας εδώ:"

msgid "plugins.generic.reviewerCertificate.emailCertificate.defaultSubject"
msgstr "Acknowledgement of your review for {{$journalName}}"

msgid "plugins.generic.reviewerCertificate.emailCertificate.defaultBody"
msgstr "Dear {{$reviewerName}},\n\nWe are immensely grateful for your efforts and time devoted to reviewing the manuscript entitled \"{{$submissionTitle}}\" submitted to {{$journalName}}. Your meticulous and insightful evaluation has provided valuable feedback that has helped the authors improve their work and advance their research endeavors.\n\nYour contribution to maintaining the quality of the articles published in our journal is highly appreciated. We understand that reviewing manuscripts is a demanding task, and we acknowledge the effort you put into thoroughly analyzing the submission and providing constructive criticism to the authors.\n\nTo show our appreciation for your hard work, we would like to kindly ask you to forward this letter to reviews@webofscience.com. Please note that in accordance with our editorial policy, the content of the review will remain confidential and will not be displayed on Web of Science.\n\nYour reviewer certificate is attached to this letter.\n\nOnce again, we extend our gratitude for your commitment to the advancement of research in your field. We hope to continue collaborating with you in the future.\n\nBest regards,\n\n{{$editorName}}\n{{$journalName}}"

msgid "plugins.generic.reviewerCertificate.notifications.title"
msgstr "Historical certificate notifications"

msgid "plugins.generic.reviewerCertificate.notifications.description"
msgstr "Explicitly send one availability email per certificate to the selected reviewers. Missing eligible certificates will be created. Certificates issued before notification tracking have unknown delivery history and may already have been announced. Ordinary batch generation does not send email."

msgid "plugins.generic.reviewerCertificate.notifications.retry"
msgstr "Retry failed or uncertain deliveries"

msgid "plugins.generic.reviewerCertificate.notifications.retryWarning"
msgstr "A delivery interrupted for more than ten minutes is uncertain: the recipient may have received it. Retry uncertain deliveries only after checking your mail logs."

msgid "plugins.generic.reviewerCertificate.notifications.send"
msgstr "Send certificate notifications"

msgid "plugins.generic.reviewerCertificate.notifications.sent"
msgstr "Sent"

msgid "plugins.generic.reviewerCertificate.settings.saveFailed"
msgstr "Certificate settings could not be saved. Check the fields and image (JPEG or PNG, up to 5 MB), then try again."

