# Plugin metadata
msgid "plugins.generic.reviewerCertificate.displayName"
msgstr "Πρόσθετο Πιστοποιητικού Κριτή"

msgid "plugins.generic.reviewerCertificate.description"
msgstr "Επιτρέπει στους κριτές να δημιουργούν και να κατεβάζουν εξατομικευμένα πιστοποιητικά αναγνώρισης PDF μετά την ολοκλήρωση κριτικών."

# Certificate titles
msgid "plugins.generic.reviewerCertificate.certificateTitle"
msgstr "Πιστοποιητικό Κριτικής"

msgid "plugins.generic.reviewerCertificate.certificateSubject"
msgstr "Πιστοποιητικό Αξιολόγησης από Ομότιμους"

# Dashboard messages
msgid "plugins.generic.reviewerCertificate.certificateAvailable"
msgstr "Το Πιστοποιητικό σας είναι Έτοιμο!"

msgid "plugins.generic.reviewerCertificate.certificateAvailableDescription"
msgstr "Σας ευχαριστούμε για την ολοκλήρωση αυτής της κριτικής. Μπορείτε τώρα να κατεβάσετε το πιστοποιητικό αναγνώρισής σας."

msgid "plugins.generic.reviewerCertificate.certificateWillBeGenerated"
msgstr "Το πιστοποιητικό σας θα δημιουργηθεί αυτόματα όταν κάνετε κλικ στο κουμπί λήψης."

msgid "plugins.generic.reviewerCertificate.downloadCertificate"
msgstr "Λήψη Πιστοποιητικού"

# Settings form
msgid "plugins.generic.reviewerCertificate.settings.description"
msgstr "Διαμόρφωση προτύπων πιστοποιητικών και κριτηρίων επιλεξιμότητας για τους κριτές."

msgid "plugins.generic.reviewerCertificate.settings.templateSettings"
msgstr "Ρυθμίσεις Προτύπου Πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.backgroundImage"
msgstr "Εικόνα Φόντου"

msgid "plugins.generic.reviewerCertificate.settings.backgroundImageDescription"
msgstr "Fills the whole page behind everything else, e.g. a border or a coloured band. 2970 × 2100 px for A4 landscape, 2100 × 2970 px for portrait."

msgid "plugins.generic.reviewerCertificate.settings.currentImage"
msgstr "Τρέχουσα εικόνα φόντου"

msgid "plugins.generic.reviewerCertificate.settings.headerText"
msgstr "Κείμενο Επικεφαλίδας"

msgid "plugins.generic.reviewerCertificate.settings.headerTextDescription"
msgstr "Η κύρια επικεφαλίδα που εμφανίζεται στην κορυφή του πιστοποιητικού"

msgid "plugins.generic.reviewerCertificate.settings.headerTextRequired"
msgstr "Το κείμενο επικεφαλίδας είναι υποχρεωτικό"

