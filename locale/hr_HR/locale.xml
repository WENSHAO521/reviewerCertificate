	<!-- Body Top Offset -->
	<message key="plugins.generic.reviewerCertificate.settings.bodyTopOffset">Body Top Spacing (mm)</message>
	<message key="plugins.generic.reviewerCertificate.settings.bodyTopOffsetDescription">Extra blank space in millimetres above the body text. Use this to move the body down the page; blank lines typed at the start of the body template are removed when the form is saved.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography">Typography (Structured Layout)</message>
	<message key="plugins.generic.reviewerCertificate.settings.layoutMode">Certificate Layout</message>
	<message key="plugins.generic.reviewerCertificate.settings.layoutModeDescription">Classic renders the body template as one block of text, as in earlier versions. Structured gives each line its own style: a line holding only {{$reviewerName}} (or first/last name) uses the reviewer name style, a line holding only {{$journalName}} uses the journal name style, lines with a date or {{$certificateCode}} use the detail style, and all other lines use the body text style. Blank lines in the template add paragraph spacing. Long names and titles shrink to fit one line, then wrap, and the whole layout scales down if needed to stay on one page.</message>
	<message key="plugins.generic.reviewerCertificate.settings.layoutMode.classic">Classic (single text block)</message>
	<message key="plugins.generic.reviewerCertificate.settings.layoutMode.structured">Structured (separate title, name, journal and detail styles)</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.title">Certificate Title</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.titleDescription">Style of the header text. By default it is drawn at the top; put {{$certificateTitle}} on its own line in the body template to draw it there instead (for example below the journal name). Leave colour empty to use the general text colour. Suggested: 28–30 pt, bold.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.name">Reviewer Name</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.nameDescription">Applies to body lines that contain only the reviewer name. Suggested: 24–26 pt, bold.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.journal">Journal Name</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.journalDescription">Applies to body lines that contain only the journal name. Suggested: 16–18 pt.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.body">Acknowledgement Text</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.bodyDescription">Applies to all other body lines. Suggested: 12–14 pt.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.detail">Review Date and Certificate Code</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.detailDescription">Applies to body lines containing a date or the certificate code, and to the certificate code line. Suggested: 9–11 pt.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.size">Size (pt)</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.bold">Bold</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.spacing">Spacing (mm)</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.spacingDescription">Paragraph spacing is added for each blank line between body lines. Name spacing is extra space above and below the reviewer name. Side margin narrows the text area so text stays clear of logos in the background image.</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.paragraphSpacing">Paragraph spacing</message>
	<message key="plugins.generic.reviewerCertificate.settings.typography.nameSpacing">Name spacing</message>
